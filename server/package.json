{
  "name": "nyc-life-server",
  "version": "0.1.0",
  "description": "NYC Life backend: accounts, cloud saves, leaderboards, gallery, transfers and real-time city rooms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4",
    "colyseus": "^0.18.9"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
